{
  "name": "loreweave",
  "version": "0.1.0",
  "private": true,
  "description": "웹소설 작가를 위한 Local-first AI-assisted Writing IDE",
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"tests/core/**/*.test.ts\"",
    "perf": "electron-vite build && tsx scripts/perf.ts",
    "perf:index": "tsx scripts/perf-index.ts",
    "export:predictions": "tsx scripts/export-predictions.ts",
    "ai-script": "node scripts/electron-run.mjs",
    "test:e2e": "electron-vite build && node --import tsx --test --test-timeout=60000 --test-concurrency=1 \"tests/e2e/**/*.test.ts\""
  },
  "devDependencies": {
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-blockquote": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.3",
    "electron-vite": "6.0.0",
    "playwright": "1.64.1",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "8.3.5"
  },
  "dependencies": {
    "openai": "7.43.0"
  }
}
