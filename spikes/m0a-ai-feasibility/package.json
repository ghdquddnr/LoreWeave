{
  "name": "m0a-ai-feasibility",
  "private": true,
  "type": "module",
  "description": "M0-A spike: continuity-error detection strategies. Not product code.",
  "scripts": {
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "evaluate": "tsx src/evaluate.ts",
    "probe": "node --env-file=.env --import tsx src/probe.ts",
    "run:strategy": "node --env-file=.env --no-warnings=ExperimentalWarning --import tsx src/run.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "openai": "^7.43.0"
  }
}
